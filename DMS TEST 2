function field(label, id, value, required, type){
  return '<div class="field"><label>'+escapeHtml(label)+(required?' <span class="req">*</span>':'')+'</label>' +
    '<input id="'+id+'" type="'+(type||'text')+'" value="'+escapeHtml(value||'')+'"></div>';
}
function selectField(label, id, options, selected){
  return '<div class="field"><label>'+escapeHtml(label)+'</label><select id="'+id+'">' +
    options.map(o => '<option value="'+escapeHtml(o)+'"'+(o===selected?' selected':'')+'>'+escapeHtml(o)+'</option>').join('') +
    '</select></div>';
}

async function saveCargoForm(id){
  const trackingNumber = byId('cf-tracking').value.trim();
  if(!trackingNumber){ showToast('Tracking number is required.', 'error'); return; }
  const data = {
    trackingNumber,
    containerNumber: byId('cf-container').value.trim(),
    billOfLading: byId('cf-bl').value.trim(),
    billOfEntry: byId('cf-boe').value.trim(),
    receiptOfPayment: byId('cf-receipt').value.trim(),
    description: byId('cf-desc').value.trim(),
    dateOfEntry: byId('cf-date').value || todayStr(),
    status: byId('cf-status').value,
  };
  if(id){
    const rec = state.cargo.find(c=>c.id===id);
    Object.assign(rec, data);
  } else {
    data.id = uid();
    data.createdAt = new Date().toISOString();
    state.cargo.push(data);
  }
  await saveData();
  closeModal();
  showToast(id ? 'Cargo record updated.' : 'Cargo record saved.', 'success');
  renderMain();
}

async function deleteCargo(id){
  if(!requireAdmin('delete cargo records')) return;
  if(!confirm('Delete this cargo record? This cannot be undone.')) return;
  state.cargo = state.cargo.filter(c=>c.id!==id);
  await saveData();
  showToast('Cargo record deleted.');
  renderMain();
}
