      field('Container Number','cf-container', v.containerNumber) +
      field('Bill of Lading (BL)','cf-bl', v.billOfLading) +
      field('Bill of Entry (BOE)','cf-boe', v.billOfEntry) +
      field('Receipt of Payment','cf-receipt', v.receiptOfPayment) +
      field('Date of Entry','cf-date', v.dateOfEntry, false, 'date') +
      selectField('Status','cf-status', CARGO_STATUSES, v.status) +
      '<div class="field span2"><label>Description of Goods Inside Container</label><textarea id="cf-desc">'+escapeHtml(v.description)+'</textarea></div>' +
