          inventoryOptionsHtml(item.inventoryId) +
        '</select>' +
        '<input type="text" value="'+escapeHtml(item.description)+'" placeholder="Description" oninput="updateLineField('+idx+',\'description\',this.value)">' +
      '</div>' +
      '<input type="number" min="0" step="1" value="'+item.qty+'" oninput="updateLineField('+idx+',\'qty\',this.value)">' +
      '<input type="number" min="0" step="0.01" value="'+item.unitPrice+'" oninput="updateLineField('+idx+',\'unitPrice\',this.value)">' +
      '<div id="li-total-'+idx+'" style="font-weight:600;padding-top:8px;">'+formatMoney(lineTotal)+'</div>' +
      '<button type="button" class="remove-line" onclick="removeLineItem('+idx+')" title="Remove line">&times;</button>' +
    '</div>';
  }).join('');
}

function pickInventoryForLine(idx, invId){
  const item = builderState.items[idx];
  if(!invId){ item.inventoryId = null; }
  else {
    const inv = state.inventory.find(i=>i.id===invId);
    if(inv){
      item.inventoryId = inv.id;
      item.description = inv.name + (inv.code? ' ('+inv.code+')':'');
      item.unitPrice = builderState.pricesIncludeVat ? inv.vatInclusivePrice : inv.sellingPrice;
      if(!item.qty) item.qty = 1;
    }
  }
  byId('li-container').innerHTML = renderLineItemsRows();
  renderTotalsBox();
}

function updateLineField(idx, field, value){
  const item = builderState.items[idx];
  if(field === 'qty' || field === 'unitPrice') item[field] = parseFloat(value) || 0;
  else item[field] = value;
  if(field !== 'description'){
    const lineTotal = (Number(item.qty)||0) * (Number(item.unitPrice)||0);
    const totalEl = byId('li-total-'+idx);
    if(totalEl) totalEl.textContent = formatMoney(lineTotal);
    renderTotalsBox();
  }
}

function addLineItem(){
  builderState.items.push(blankLine());
  byId('li-container').innerHTML = renderLineItemsRows();
  renderTotalsBox();
}

function removeLineItem(idx){
  if(builderState.items.length <= 1){ showToast('A document needs at least one line item.', 'error'); return; }
  builderState.items.splice(idx,1);
  byId('li-container').innerHTML = renderLineItemsRows();
  renderTotalsBox();
}

function computeBuilderTotals(){
  const lines = builderState.items.map(i => (Number(i.qty)||0) * (Number(i.unitPrice)||0));
  const sum = lines.reduce((a,b)=>a+b,0);
  const rate = state.settings.vatRate/100;
  let subtotal, vatAmount, total;
  if(builderState.pricesIncludeVat){
    total = sum;
    subtotal = +(total / (1+rate)).toFixed(2);
    vatAmount = +(total - subtotal).toFixed(2);
  } else {
    subtotal = +sum.toFixed(2);
    vatAmount = +(subtotal * rate).toFixed(2);
    total = +(subtotal + vatAmount).toFixed(2);
  }
  return { subtotal, vatAmount, total };
}

function totalsBoxHtml(){
  const t = computeBuilderTotals();
  return '<div class="totals-box">' +
    '<div class="trow"><span>Subtotal (excl. VAT)</span><span>'+formatMoney(t.subtotal)+'</span></div>' +
    '<div class="trow"><span>VAT ('+state.settings.vatRate+'%)</span><span>'+formatMoney(t.vatAmount)+'</span></div>' +
    '<div class="trow grand"><span>Total</span><span>'+formatMoney(t.total)+'</span></div>' +
  '</div>';
}

function renderTotalsBox(){
  const el = byId('totals-box');
  if(el) el.innerHTML = totalsBoxHtml();
}

function previewDocNumber(type){
  const year = new Date().getFullYear();
  const next = (state.counters[type]||0) + 1;
  return DOC_PREFIX[type] + '-' + year + '-' + String(next).padStart(4,'0');
}

function nextDocNumber(type){
  state.counters[type] = (state.counters[type]||0) + 1;
  const year = new Date().getFullYear();
  return DOC_PREFIX[type] + '-' + year + '-' + String(state.counters[type]).padStart(4,'0');
}

async function saveDocBuilder(){
  const b = builderState;
  let customerId = byId('db-customer') ? byId('db-customer').value : b.customerId;

  if(b.quickAdd){
    const qaName = byId('qa-name').value.trim();
    if(!qaName){ showToast('Enter a name for the new customer.', 'error'); return; }
    const newCust = {
      id: uid(), fullName: qaName, contact: byId('qa-contact').value.trim(),
      email:'', nationalId:'', address:'',
      customerType: VEHICLE_DOC_FLOW.includes(b.type) ? 'Vehicle' : 'SparePartsImplement',
      createdAt: new Date().toISOString()
    };
    state.customers.push(newCust);
    customerId = newCust.id;
  }
  if(!customerId){ showToast('Select or add a customer first.', 'error'); return; }

  const cleanItems = b.items
    .map(i => ({ inventoryId:i.inventoryId, description:i.description.trim(), qty:Number(i.qty)||0, unitPrice:Number(i.unitPrice)||0, lineTotal: (Number(i.qty)||0)*(Number(i.unitPrice)||0) }))
    .filter(i => i.description && i.qty > 0);
  if(cleanItems.length === 0){ showToast('Add at least one line item with a description and quantity.', 'error'); return; }

  const totals = computeBuilderTotals();
  const date = byId('db-date').value || todayStr();
  const notes = byId('db-notes').value;

  const doc = {
    id: uid(),
    type: b.type,
    number: nextDocNumber(b.type),
    date,
    customerId,
    items: cleanItems,
    pricesIncludeVat: b.pricesIncludeVat,
    subtotal: totals.subtotal,
    vatAmount: totals.vatAmount,
    total: totals.total,
    notes,
    createdAt: new Date().toISOString(),
    createdBy: state.role,
  };

  let stockWarning = false;
  if(b.type === 'Delivery Note'){
    cleanItems.forEach(li => {
      if(li.inventoryId){
        const inv = state.inventory.find(x=>x.id===li.inventoryId);
        if(inv){
          if(Number(inv.stock) < li.qty) stockWarning = true;
          inv.stock = Math.max(0, Number(inv.stock) - li.qty);
        }
      }
    });
  }

  state.documents.push(doc);
  await saveData();
  closeModal();
  showToast('Document '+doc.number+' generated.' + (stockWarning? ' Note: stock for one or more items went to 0.':''), 'success');
  docTypeFilter = '';
  navigate('documents');
  viewDocument(doc.id);
}
/* ===================== DOCUMENT PREVIEW / PRINT / PDF ===================== */
function viewDocument(id){
  const doc = state.documents.find(d=>d.id===id);
  if(!doc) return;
  const html = docPreviewHtml(doc);
  openModal(html, {
    title: doc.type + ' — ' + doc.number,
    wide: true,
    foot: '<button class="btn btn-outline" onclick="closeModal()">Close</button>' +
          '<button class="btn btn-outline" onclick="printDocument(\''+doc.id+'\')">'+icon('print')+'Print</button>' +
          '<button class="btn btn-primary" onclick="downloadDocumentPDF(\''+doc.id+'\')">'+icon('download')+'Download PDF</button>'
  });
}

function docPreviewHtml(doc){
  const cust = state.customers.find(c=>c.id===doc.customerId);
  const company = state.settings.company;
  const companyName = company.name || 'Your Dealership Name';

  let rows = doc.items.map(li =>
    '<tr><td>'+escapeHtml(li.description)+'</td><td style="text-align:right;">'+li.qty+'</td><td style="text-align:right;">'+formatMoney(li.unitPrice)+'</td><td style="text-align:right;">'+formatMoney(li.lineTotal)+'</td></tr>'
  ).join('');

  let html = '<div class="doc-preview" id="dp-'+doc.id+'">' +
    '<div class="dp-head">' +
      '<div><div class="dp-company">'+escapeHtml(companyName)+'</div>' +
        (company.address? '<div class="muted" style="font-size:11.5px;max-width:260px;">'+escapeHtml(company.address)+'</div>':'') +
        (company.phone||company.email? '<div class="muted" style="font-size:11.5px;">'+escapeHtml([company.phone,company.email].filter(Boolean).join(' · '))+'</div>':'') +
        (company.vatNo? '<div class="muted" style="font-size:11.5px;">VAT No: '+escapeHtml(company.vatNo)+'</div>':'') +
      '</div>' +
      '<div class="dp-meta"><div class="dp-type">'+escapeHtml(doc.type)+'</div>' +
        '<div style="margin-top:6px;">No: <strong>'+escapeHtml(doc.number)+'</strong></div>' +
        '<div>Date: '+formatDate(doc.date)+'</div>' +
      '</div>' +
    '</div>' +
    '<div class="dp-parties">' +
      '<div><div class="dp-label">Bill To / Customer</div>' +
        '<div><strong>'+escapeHtml(cust?cust.fullName:'Unknown customer')+'</strong></div>' +
        (cust && cust.address? '<div>'+escapeHtml(cust.address)+'</div>':'') +
        (cust && cust.contact? '<div>'+escapeHtml(cust.contact)+'</div>':'') +
        (cust && cust.email? '<div>'+escapeHtml(cust.email)+'</div>':'') +
        (cust && cust.nationalId? '<div>ID/BRN: '+escapeHtml(cust.nationalId)+'</div>':'') +
      '</div>' +
    '</div>' +
    '<table><thead><tr><th>Description</th><th style="text-align:right;">Qty</th><th style="text-align:right;">Unit Price</th><th style="text-align:right;">Amount</th></tr></thead><tbody>' +
    rows + '</tbody></table>' +
    '<div class="dp-totals">' +
      '<div class="trow" style="display:flex;justify-content:space-between;padding:4px 0;"><span>Subtotal</span><span>'+formatMoney(doc.subtotal)+'</span></div>' +
      '<div class="trow" style="display:flex;justify-content:space-between;padding:4px 0;"><span>VAT ('+state.settings.vatRate+'%)</span><span>'+formatMoney(doc.vatAmount)+'</span></div>' +
      '<div class="trow" style="display:flex;justify-content:space-between;padding:6px 0;font-weight:800;border-top:1px solid var(--ink);"><span>Total</span><span>'+formatMoney(doc.total)+'</span></div>' +
    '</div>' +
    (doc.notes? '<div class="dp-terms">'+escapeHtml(doc.notes)+'</div>' : '');

  if(SIGNATURE_DOC_TYPES.includes(doc.type)){
    const labels = signatureLabels(doc.type);
    html += '<div class="dp-sign">' +
      '<div class="dp-sign-block">'+labels[0]+'</div>' +
      '<div class="dp-sign-block">'+labels[1]+'</div>' +
    '</div>';
  }

  html += '</div>';
  return html;
}

function signatureLabels(type){
  if(type === 'Delivery Note') return ['Delivered By — Name &amp; Signature', 'Received By — Name &amp; Signature'];
  if(type === 'Deed of Sale') return ['Dealership Representative — Signature', 'Buyer — Signature'];
  if(type === 'Agreement') return ['Dealership Representative — Signature', 'Customer — Signature'];
  if(type === 'Purchase Order') return ['Authorized By — Signature', 'Supplier Acknowledgement — Signature'];
  return ['Signature', 'Signature'];
}

function printDocument(id){
  const doc = state.documents.find(d=>d.id===id);
  if(!doc) return;
  byId('print-area').innerHTML = docPreviewHtml(doc);
  window.print();
}

function downloadDocumentPDF(id){
  const doc = state.documents.find(d=>d.id===id);
  if(!doc) return;
  if(!window.jspdf){ showToast('PDF library failed to load. Try Print instead.', 'error'); return; }
  const { jsPDF } = window.jspdf;
  const pdf = new jsPDF({ unit:'pt', format:'a4' });
  const cust = state.customers.find(c=>c.id===doc.customerId);
  const company = state.settings.company;
  const companyName = company.name || 'Your Dealership Name';
  const marginX = 40;
  let y = 50;

  pdf.setFont('helvetica','bold'); pdf.setFontSize(16);
  pdf.text(companyName, marginX, y);
  pdf.setFont('helvetica','normal'); pdf.setFontSize(9); pdf.setTextColor(90);
  let infoY = y + 16;
  [company.address, [company.phone, company.email].filter(Boolean).join('  ·  '), company.vatNo? 'VAT No: '+company.vatNo : ''].forEach(line=>{
    if(line){ pdf.text(String(line), marginX, infoY); infoY += 12; }
  });

  pdf.setTextColor(20);
  pdf.setFont('helvetica','bold'); pdf.setFontSize(13);
  pdf.text(doc.type.toUpperCase(), 555, y, { align:'right' });
  pdf.setFont('helvetica','normal'); pdf.setFontSize(10);
  pdf.text('No: ' + doc.number, 555, y+16, { align:'right' });
  pdf.text('Date: ' + formatDate(doc.date), 555, y+30, { align:'right' });

  y = Math.max(infoY, y+50) + 14;
  pdf.setDrawColor(20); pdf.setLineWidth(1.2);
  pdf.line(marginX, y, 555, y);
  y += 22;

  pdf.setFont('helvetica','bold'); pdf.setFontSize(9); pdf.setTextColor(110);
  pdf.text('BILL TO / CUSTOMER', marginX, y);
  y += 14;
  pdf.setFont('helvetica','bold'); pdf.setFontSize(11); pdf.setTextColor(20);
  pdf.text(cust ? cust.fullName : 'Unknown customer', marginX, y);
  pdf.setFont('helvetica','normal'); pdf.setFontSize(9.5);
  y += 13;
  [cust && cust.address, cust && cust.contact, cust && cust.email, cust && cust.nationalId ? 'ID/BRN: '+cust.nationalId : null].forEach(line=>{
    if(line){ pdf.text(String(line), marginX, y); y += 12; }
  });

  y += 14;
  const body = doc.items.map(li => [li.description, String(li.qty), formatMoney(li.unitPrice), formatMoney(li.lineTotal)]);
  pdf.autoTable({
    startY: y,
    head: [['Description','Qty','Unit Price','Amount']],
    body,
    margin: { left:marginX, right:40 },
    styles: { fontSize:9.5, cellPadding:6 },
    headStyles: { fillColor:[36,67,94], textColor:255, fontStyle:'bold' },
    columnStyles: { 1:{halign:'right',cellWidth:40}, 2:{halign:'right',cellWidth:90}, 3:{halign:'right',cellWidth:90} }
  });

  let finalY = pdf.lastAutoTable.finalY + 16;
  const totalsX = 555;
  pdf.setFontSize(10);
  pdf.text('Subtotal', totalsX-150, finalY); pdf.text(formatMoney(doc.subtotal), totalsX, finalY, {align:'right'});
  finalY += 15;
  pdf.text('VAT ('+state.settings.vatRate+'%)', totalsX-150, finalY); pdf.text(formatMoney(doc.vatAmount), totalsX, finalY, {align:'right'});
  finalY += 4;
  pdf.setLineWidth(0.7); pdf.line(totalsX-150, finalY+4, totalsX, finalY+4);
  finalY += 18;
  pdf.setFont('helvetica','bold'); pdf.setFontSize(11.5);
  pdf.text('Total', totalsX-150, finalY); pdf.text(formatMoney(doc.total), totalsX, finalY, {align:'right'});

  finalY += 30;
  if(doc.notes){
    pdf.setFont('helvetica','normal'); pdf.setFontSize(8.5); pdf.setTextColor(100);
    const split = pdf.splitTextToSize(doc.notes, 515);
    pdf.text(split, marginX, finalY);
    finalY += split.length * 11 + 20;
  }

  if(SIGNATURE_DOC_TYPES.includes(doc.type)){
    finalY = Math.max(finalY, 700);
    if(finalY > 760){ pdf.addPage(); finalY = 60; }
    const labels = signatureLabels(doc.type).map(l=>l.replace(/&amp;/g,'&'));
    pdf.setDrawColor(20); pdf.setLineWidth(0.8);
    pdf.line(marginX, finalY, marginX+220, finalY);
    pdf.line(330, finalY, 555, finalY);
    pdf.setFontSize(8.5); pdf.setTextColor(90);
    pdf.text(labels[0], marginX, finalY+12);
    pdf.text(labels[1], 330, finalY+12);
  }

  pdf.save(doc.number + '.pdf');
  showToast('PDF downloaded.', 'success');
}
/* ===================== SETTINGS MODULE ===================== */
function renderSettingsView(){
  if(!isAdmin()){
    return '<div class="card">' + emptyState('settings', 'Administrator access required',
      'Switch to the Administrator role in the top bar to view and change company settings.', '', null) + '</div>';
  }
  const c = state.settings.company;
  let html = '<div class="card">' +
    '<h2 class="section-title">Company Details</h2>' +
    '<p class="muted" style="margin-top:-8px;margin-bottom:16px;">Used as the letterhead on every generated document.</p>' +
    '<div class="form-grid">' +
      field('Company Name','st-name', c.name) +
      field('VAT Registration No.','st-vatno', c.vatNo) +
      field('Phone','st-phone', c.phone) +
      field('Email','st-email', c.email) +
      '<div class="field span2"><label>Address</label><textarea id="st-address">'+escapeHtml(c.address)+'</textarea></div>' +
    '</div>' +
    '<div style="margin-top:16px;"><button class="btn btn-primary" onclick="saveCompanySettings()">Save Company Details</button></div>' +
  '</div>';

  html += '<div class="card">' +
    '<h2 class="section-title">System Preferences</h2>' +
    '<div class="form-grid">' +
      field('Default VAT Rate (%)','st-vatrate', state.settings.vatRate, false, 'number') +
      field('Low Stock Alert Threshold (units)','st-lowstock', state.settings.lowStockThreshold, false, 'number') +
    '</div>' +
    '<div style="margin-top:16px;"><button class="btn btn-primary" onclick="savePreferences()">Save Preferences</button></div>' +
  '</div>';

  html += '<div class="card" style="border-color:var(--danger);">' +
    '<h2 class="section-title" style="color:var(--danger);">Danger Zone</h2>' +
    '<p class="muted">This permanently erases all cargo, inventory, customers and documents for everyone using this DealerDesk link.</p>' +
    '<button class="btn btn-danger-outline" onclick="resetAllData()">'+icon('trash')+'Erase All Data</button>' +
  '</div>';

  return html;
}

async function saveCompanySettings(){
  state.settings.company = {
    name: byId('st-name').value.trim(),
    vatNo: byId('st-vatno').value.trim(),
    phone: byId('st-phone').value.trim(),
    email: byId('st-email').value.trim(),
    address: byId('st-address').value.trim(),
  };
  await saveData();
  showToast('Company details saved.', 'success');
}

async function savePreferences(){
  state.settings.vatRate = parseFloat(byId('st-vatrate').value) || 0;
  state.settings.lowStockThreshold = parseFloat(byId('st-lowstock').value) || 0;
  await saveData();
  showToast('Preferences saved.', 'success');
  renderMain();
}

async function resetAllData(){
  if(!requireAdmin('erase all data')) return;
  if(!confirm('This will permanently delete ALL cargo, inventory, customers and documents for everyone. Type OK to confirm — this cannot be undone. Continue?')) return;
  if(!confirm('Final confirmation: erase everything now?')) return;
  const keepSettings = state.settings;
  state = JSON.parse(JSON.stringify(DEFAULT_STATE));
  state.settings = keepSettings;
  await saveData();
  showToast('All data erased.');
  navigate('dashboard');
}

/* ===================== INIT ===================== */
async function initApp(){
  renderShell();
  setSaveIndicator('saving');
  await loadData();
  byId('role-select').value = state.role;
  setSaveIndicator('saved');
  navigate('dashboard');
}

if(document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', initApp);
} else {
  initApp();
}

</script>
