const DEFAULT_TERMS = {
  'Quotation': 'This quotation is valid for 14 days from the date of issue. Prices are subject to change without prior notice. Availability of stock is not guaranteed until full payment is received.',
  'Proforma Invoice': 'This proforma invoice is issued for payment processing purposes and is not a tax invoice. Goods remain the property of the dealership until payment is received in full.',
  'VAT Invoice': 'Thank you for your business. This is a VAT invoice issued in accordance with applicable tax regulations.',
  'Purchase Order': 'Please supply the goods/services listed above on the terms agreed between both parties.',
  'Delivery Note': 'Goods listed above have been delivered in good condition. Please inspect on receipt and report any discrepancy within 48 hours.',
  'Deed of Sale': 'This Deed of Sale confirms the transfer of ownership of the item(s) listed above from the Dealership to the Buyer, subject to full payment having been received.',
  'Agreement': 'This Agreement is entered into between the Dealership and the Customer named above, governing the terms of sale described in this document.'
};
const LEGAL_DOC_TYPES = ['Deed of Sale','Agreement'];
const SIGNATURE_DOC_TYPES = ['Delivery Note','Deed of Sale','Agreement','Purchase Order'];
/* ===================== DOCUMENT BUILDER ===================== */
let builderState = null;

function openDocBuilder(type, presetCustomerId){
  builderState = {
    type: type || 'Quotation',
    customerId: presetCustomerId || '',
    date: todayStr(),
    items: [ blankLine() ],
    notes: DEFAULT_TERMS[type || 'Quotation'],
    pricesIncludeVat: (type === 'VAT Invoice' || type === 'Proforma Invoice'),
    quickAdd: false,
  };
  openModal(builderBodyHtml(), {
    title: 'New Document',
    wide: true,
    foot: '<button class="btn btn-outline" onclick="closeModal()">Cancel</button>' +
          '<button class="btn btn-primary" onclick="saveDocBuilder()">'+icon('plus')+'Generate Document</button>'
  });
}

