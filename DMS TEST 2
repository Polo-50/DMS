<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DealerDesk — Dealership Management</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
:root{
  --bg:#E9E7DF;
  --surface:#FFFFFF;
  --surface-alt:#F3F1EA;
  --ink:#15181D;
  --ink-soft:#5B6068;
  --ink-faint:#8A8F97;
  --line:#D9D5C9;
  --line-strong:#B9B4A5;
  --primary:#24435E;
  --primary-dark:#15293B;
  --primary-soft:#DEE6EC;
  --accent:#D98E20;
  --accent-dark:#A66912;
  --force:#C1440E;
  --force-bg:#F7E2D6;
  --mahindra:#1F6F5C;
  --mahindra-bg:#DCEEE8;
  --danger:#B23A2E;
  --danger-bg:#F6E1DD;
  --success:#3F7D4D;
  --success-bg:#E2EEE3;
  --warn:#A66912;
  --warn-bg:#F8E7C8;
  --radius:7px;
  --font-display:'Archivo',sans-serif;
  --font-body:'Inter',sans-serif;
  --font-mono:'IBM Plex Mono',monospace;
  --shadow-sm:0 1px 2px rgba(21,23,29,0.08);
  --shadow-md:0 6px 20px rgba(21,23,29,0.12);
}
*,*::before,*::after{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:var(--font-body);
  background:var(--bg);
  color:var(--ink);
  font-size:14px;
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
button{font-family:inherit;}
a{color:inherit;}
::selection{background:var(--accent);color:#fff;}

/* ===== LAYOUT SHELL ===== */
#app{display:flex;min-height:100vh;}

#sidebar{
  width:230px;
  flex-shrink:0;
  background:var(--primary-dark);
  color:#E9EEF2;
  display:flex;
  flex-direction:column;
  position:sticky;
  top:0;
  height:100vh;
}
.brand{
  display:flex;
  align-items:center;
  gap:10px;
  padding:20px 18px 16px;
  border-bottom:1px solid rgba(255,255,255,0.1);
}
.brand-plate{
  width:38px;height:38px;
  border:2px solid var(--accent);
  border-radius:4px;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-display);
  font-weight:900;
  font-size:14px;
  color:var(--accent);
  letter-spacing:0.5px;
  flex-shrink:0;
}
.brand-text .name{
  font-family:var(--font-display);
  font-weight:800;
  font-size:16.5px;
  letter-spacing:0.3px;
  color:#fff;
  line-height:1.15;
}
.brand-text .tagline{
  font-size:10.5px;
  color:#9FB0BD;
  letter-spacing:0.6px;
  text-transform:uppercase;
  margin-top:2px;
}
nav.navlist{
  flex:1;
  padding:14px 10px;
  overflow-y:auto;
}
.nav-item{
  display:flex;
  align-items:center;
  gap:11px;
  padding:10px 12px;
  border-radius:6px;
  color:#C7D2DA;
  cursor:pointer;
  font-size:13.5px;
  font-weight:500;
  margin-bottom:2px;
  border-left:3px solid transparent;
  transition:background .12s ease,color .12s ease;
  user-select:none;
}
.nav-item:hover{background:rgba(255,255,255,0.06);color:#fff;}
.nav-item.active{
  background:rgba(217,142,32,0.14);
  color:#fff;
  border-left:3px solid var(--accent);
}
.nav-icon{width:17px;height:17px;flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;}
.nav-icon svg{width:17px;height:17px;}
.nav-foot{
  padding:14px 16px 18px;
  border-top:1px solid rgba(255,255,255,0.1);
  font-size:11px;
  color:#7E91A0;
  line-height:1.5;
}

#main-col{flex:1;min-width:0;display:flex;flex-direction:column;}

#topbar{
  background:var(--surface);
  border-bottom:1px solid var(--line);
  padding:14px 28px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  position:sticky;
  top:0;
  z-index:20;
}
#topbar h1{
  font-family:var(--font-display);
  font-size:19px;
  font-weight:800;
  margin:0;
  letter-spacing:0.2px;
}
#topbar .subtitle{
  font-size:12px;
  color:var(--ink-soft);
  margin-top:2px;
}
.topbar-right{display:flex;align-items:center;gap:14px;}
.save-indicator{
  font-size:11.5px;
  color:var(--ink-faint);
  display:flex;
  align-items:center;
  gap:6px;
  min-width:84px;
}
.save-dot{width:7px;height:7px;border-radius:50%;background:var(--success);flex-shrink:0;}
.save-dot.saving{background:var(--accent);animation:pulse 1s infinite ease-in-out;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.35;}}

.role-switch{
  display:flex;
  align-items:center;
  gap:8px;
  background:var(--surface-alt);
  border:1px solid var(--line);
  border-radius:20px;
  padding:4px 6px 4px 12px;
}
.role-switch label{font-size:11px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:0.4px;}
.role-switch select{
  border:none;background:var(--surface);
  font-family:inherit;font-weight:600;font-size:12.5px;
  padding:5px 10px;border-radius:14px;cursor:pointer;
  border:1px solid var(--line);
}

#main-content{padding:26px 28px 60px;flex:1;}

/* ===== TYPE ===== */
h2.section-title{
  font-family:var(--font-display);
  font-size:15px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:0.6px;
  color:var(--primary);
  margin:0 0 14px;
}
.muted{color:var(--ink-soft);}
.faint{color:var(--ink-faint);}

/* ===== BUTTONS ===== */
.btn{
  display:inline-flex;align-items:center;gap:7px;
  font-family:inherit;font-weight:600;font-size:13px;
  padding:9px 16px;border-radius:6px;border:1px solid transparent;
  cursor:pointer;transition:filter .12s ease, transform .05s ease;
  white-space:nowrap;
}
.btn:active{transform:translateY(1px);}
.btn-primary{background:var(--accent);color:#fff;}
.btn-primary:hover{filter:brightness(0.93);}
.btn-dark{background:var(--primary);color:#fff;}
.btn-dark:hover{filter:brightness(1.12);}
.btn-outline{background:var(--surface);color:var(--ink);border-color:var(--line-strong);}
.btn-outline:hover{background:var(--surface-alt);}
.btn-danger-outline{background:var(--surface);color:var(--danger);border-color:var(--danger);}
.btn-danger-outline:hover{background:var(--danger-bg);}
.btn-sm{padding:6px 11px;font-size:12px;border-radius:5px;}
.btn-icon{padding:7px 9px;}
.btn:disabled{opacity:0.45;cursor:not-allowed;}
.btn-text{background:none;border:none;color:var(--primary);font-weight:600;font-size:12.5px;cursor:pointer;padding:4px 2px;}
.btn-text:hover{text-decoration:underline;}

/* ===== STAT PLATES (signature element) ===== */
.plate-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:14px;margin-bottom:24px;}
.plate{
  background:var(--surface);
  border:1.5px solid var(--ink);
  border-top:4px solid var(--accent);
  border-radius:4px;
  padding:14px 16px 12px;
  position:relative;
}
.plate.alert{border-top-color:var(--danger);}
.plate .plate-label{
  font-family:var(--font-mono);
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:1px;
  color:var(--ink-soft);
  display:block;margin-bottom:6px;
}
.plate .plate-value{
  font-family:var(--font-display);
  font-size:28px;
  font-weight:800;
  line-height:1;
}
.plate .plate-sub{font-size:11px;color:var(--ink-faint);margin-top:5px;}
.plate-corner{position:absolute;top:6px;right:8px;width:5px;height:5px;border-radius:50%;background:var(--line-strong);}

/* code/number badge (plate motif reused inline) */
.code-tag{
  font-family:var(--font-mono);
  font-size:11.5px;
  font-weight:600;
  background:var(--surface-alt);
  border:1px solid var(--line-strong);
  border-radius:4px;
  padding:2px 7px;
  display:inline-block;
  letter-spacing:0.3px;
}

/* ===== CARD / PANEL ===== */
.card{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:20px;
  margin-bottom:20px;
}
.card-flush{padding:0;overflow:hidden;}
.toolbar{
  display:flex;align-items:center;justify-content:space-between;
  gap:12px;margin-bottom:16px;flex-wrap:wrap;
}
.toolbar-left{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.search-input{
  border:1px solid var(--line-strong);border-radius:6px;
  padding:8px 12px;font-size:13px;width:230px;font-family:inherit;background:var(--surface);
}
.search-input:focus, select:focus, input:focus, textarea:focus{outline:2px solid var(--accent);outline-offset:1px;}

/* ===== TABS ===== */
.tabbar{display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap;}
.tabbtn{
  padding:8px 16px;border-radius:6px 6px 0 0;
  border:1px solid var(--line);border-bottom:none;
  background:var(--surface-alt);color:var(--ink-soft);
  font-weight:600;font-size:13px;cursor:pointer;
}
.tabbtn.active{background:var(--surface);color:var(--ink);border-bottom:2px solid var(--surface);position:relative;top:1px;}
.subtab-row{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;}
.subtab{
  padding:6px 14px;border-radius:16px;border:1px solid var(--line-strong);
  background:var(--surface);font-size:12.5px;font-weight:600;cursor:pointer;color:var(--ink-soft);
}
.subtab.active{background:var(--primary);border-color:var(--primary);color:#fff;}

.brand-chip{
  display:inline-flex;align-items:center;gap:5px;
  padding:2px 9px;border-radius:12px;font-size:11px;font-weight:700;
  text-transform:uppercase;letter-spacing:0.3px;
}
.brand-chip.force{background:var(--force-bg);color:var(--force);}
.brand-chip.mahindra{background:var(--mahindra-bg);color:var(--mahindra);}

/* ===== TABLE ===== */
.table-wrap{overflow-x:auto;}
table.data-table{width:100%;border-collapse:collapse;font-size:13px;}
table.data-table th{
  text-align:left;font-family:var(--font-mono);font-size:10.5px;
  text-transform:uppercase;letter-spacing:0.6px;color:var(--ink-soft);
  padding:10px 12px;border-bottom:2px solid var(--ink);white-space:nowrap;
}
table.data-table td{padding:11px 12px;border-bottom:1px solid var(--line);vertical-align:middle;}
table.data-table tbody tr:hover{background:var(--surface-alt);}
table.data-table tbody tr.row-clickable{cursor:pointer;}
.row-actions{display:flex;gap:6px;justify-content:flex-end;}
.empty-row td{padding:36px 12px;}

.badge{display:inline-block;padding:3px 9px;border-radius:11px;font-size:11px;font-weight:700;letter-spacing:0.2px;}
.badge.status-pending{background:var(--warn-bg);color:var(--warn);}
.badge.status-transit{background:var(--primary-soft);color:var(--primary);}
.badge.status-cleared{background:var(--success-bg);color:var(--success);}
.badge.status-delivered{background:#E4E2F4;color:#4B3F9E;}
.badge.status-released{background:var(--surface-alt);color:var(--ink-soft);}
.badge.low-stock{background:var(--danger-bg);color:var(--danger);}
.badge.ok-stock{background:var(--success-bg);color:var(--success);}

/* ===== EMPTY STATE ===== */
.empty-state{
  text-align:center;padding:50px 20px;color:var(--ink-soft);
}
.empty-state .empty-icon{font-size:30px;margin-bottom:10px;opacity:0.5;}
.empty-state h3{font-family:var(--font-display);font-size:15px;margin:0 0 6px;color:var(--ink);}
.empty-state p{font-size:13px;margin:0 0 16px;}

/* ===== MODAL ===== */
#modal-root{position:fixed;inset:0;z-index:100;display:none;}
#modal-root.open{display:block;}
.modal-backdrop{position:absolute;inset:0;background:rgba(21,23,29,0.55);}
.modal-box{
  position:relative;background:var(--surface);border-radius:10px;
  max-width:640px;width:92%;margin:5vh auto;max-height:90vh;
  display:flex;flex-direction:column;box-shadow:var(--shadow-md);
}
.modal-box.wide{max-width:880px;}
.modal-head{
  padding:18px 22px;border-bottom:1px solid var(--line);
  display:flex;align-items:center;justify-content:space-between;
}
.modal-head h3{font-family:var(--font-display);font-size:16px;margin:0;}
.modal-close{background:none;border:none;font-size:20px;cursor:pointer;color:var(--ink-soft);line-height:1;padding:4px;}
.modal-close:hover{color:var(--ink);}
.modal-body{padding:20px 22px;overflow-y:auto;}
.modal-foot{padding:16px 22px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:10px;}

/* ===== FORM ===== */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.form-grid.single{grid-template-columns:1fr;}
.field{display:flex;flex-direction:column;gap:5px;}
.field.span2{grid-column:1/-1;}
.field label{font-size:12px;font-weight:600;color:var(--ink-soft);}
.field label .req{color:var(--danger);}
.field input,.field select,.field textarea{
  border:1px solid var(--line-strong);border-radius:6px;
  padding:9px 11px;font-size:13.5px;font-family:inherit;background:var(--surface);width:100%;
}
.field textarea{resize:vertical;min-height:70px;}
.field-hint{font-size:11px;color:var(--ink-faint);}

/* ===== TOAST ===== */
#toast-root{position:fixed;bottom:20px;right:20px;z-index:200;display:flex;flex-direction:column;gap:8px;}
.toast{
  background:var(--ink);color:#fff;padding:11px 16px;border-radius:7px;
  font-size:13px;box-shadow:var(--shadow-md);min-width:220px;
  display:flex;align-items:center;gap:9px;
  animation:slideIn .18s ease;
}
.toast.error{background:var(--danger);}
.toast.success{background:var(--success);}
@keyframes slideIn{from{transform:translateY(8px);opacity:0;}to{transform:translateY(0);opacity:1;}}

/* ===== DOC TYPE GRID ===== */
.doctype-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;margin-bottom:24px;}
.doctype-card{
  background:var(--surface);border:1px solid var(--line);border-radius:8px;
  padding:16px 14px;cursor:pointer;transition:border-color .12s ease, transform .08s ease;
}
.doctype-card:hover{border-color:var(--accent);transform:translateY(-2px);}
.doctype-card .dt-prefix{font-family:var(--font-mono);font-size:10.5px;color:var(--accent-dark);font-weight:700;letter-spacing:1px;}
.doctype-card .dt-name{font-family:var(--font-display);font-weight:700;font-size:14px;margin-top:5px;}
.doctype-card .dt-count{font-size:11px;color:var(--ink-faint);margin-top:6px;}

/* line items table inside builder */
.lineitem-row{display:grid;grid-template-columns:2.2fr 0.8fr 1fr 1fr 28px;gap:8px;align-items:center;margin-bottom:8px;}
.lineitem-row input,.lineitem-row select{padding:7px 9px;font-size:12.5px;}
.lineitem-head{display:grid;grid-template-columns:2.2fr 0.8fr 1fr 1fr 28px;gap:8px;font-size:10.5px;text-transform:uppercase;letter-spacing:0.5px;color:var(--ink-soft);margin-bottom:6px;font-family:var(--font-mono);}
.remove-line{background:none;border:none;color:var(--danger);font-size:16px;cursor:pointer;}
.totals-box{margin-top:14px;border-top:1px solid var(--line);padding-top:12px;display:flex;flex-direction:column;gap:6px;align-items:flex-end;}
.totals-box .trow{display:flex;gap:30px;font-size:13px;width:240px;justify-content:space-between;}
.totals-box .trow.grand{font-weight:800;font-size:15px;border-top:1px solid var(--line);padding-top:7px;}

/* ===== DOC PREVIEW / PRINT ===== */
.doc-preview{background:#fff;border:1px solid var(--line);border-radius:8px;padding:36px;font-size:13px;color:#15181D;}
.doc-preview .dp-head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid var(--ink);padding-bottom:16px;margin-bottom:20px;}
.doc-preview .dp-company{font-family:var(--font-display);font-weight:800;font-size:20px;}
.doc-preview .dp-meta{font-family:var(--font-mono);text-align:right;font-size:12px;}
.doc-preview .dp-meta .dp-type{font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1px;color:var(--accent-dark);}
.doc-preview .dp-parties{display:flex;justify-content:space-between;gap:30px;margin-bottom:22px;}
.doc-preview .dp-label{font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:0.6px;color:var(--ink-soft);margin-bottom:4px;}
.doc-preview table{width:100%;border-collapse:collapse;margin-bottom:18px;}
.doc-preview th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:0.4px;border-bottom:2px solid var(--ink);padding:8px 6px;}
.doc-preview td{padding:8px 6px;border-bottom:1px solid var(--line);}
.doc-preview .dp-totals{margin-left:auto;width:260px;}
.doc-preview .dp-terms{margin-top:24px;font-size:12px;color:var(--ink-soft);white-space:pre-wrap;line-height:1.6;}
.doc-preview .dp-sign{display:flex;justify-content:space-between;margin-top:50px;gap:30px;}
.doc-preview .dp-sign-block{flex:1;border-top:1px solid var(--ink);padding-top:6px;font-size:11px;color:var(--ink-soft);}

@media print{
  body *{visibility:hidden;}
  #print-area, #print-area *{visibility:visible;}
  #print-area{position:absolute;top:0;left:0;width:100%;padding:20px;}
  .no-print{display:none !important;}
}

@media (max-width:880px){
  #sidebar{position:fixed;left:0;right:0;top:0;width:100%;height:auto;flex-direction:row;z-index:50;}
  .brand{border-bottom:none;padding:10px 14px;}
  .brand-text .tagline{display:none;}
  nav.navlist{display:flex;flex-direction:row;overflow-x:auto;padding:6px;flex:none;}
  .nav-item{flex-shrink:0;border-left:none;border-bottom:3px solid transparent;}
  .nav-item.active{border-left:none;border-bottom:3px solid var(--accent);}
  .nav-foot{display:none;}
  #main-col{padding-top:104px;}
  .form-grid{grid-template-columns:1fr;}
  .lineitem-row{grid-template-columns:1fr;gap:4px;background:var(--surface-alt);padding:8px;border-radius:6px;margin-bottom:10px;}
  .lineitem-head{display:none;}
}
</style>
</head>
<body>
<div id="app"></div>
<div id="modal-root"><div class="modal-backdrop" onclick="closeModal()"></div><div id="modal-container"></div></div>
<div id="toast-root"></div>
<div id="print-area"></div>
<script>
/* =========================================================
   DEALERDESK — APPLICATION SCRIPT
   Sections: STATE & STORAGE | UTILITIES | ICONS | SHELL/ROUTER
   DASHBOARD | CARGO | INVENTORY | CUSTOMERS | DOCUMENTS | SETTINGS
   MODAL | TOAST | PDF/PRINT | INIT
   ========================================================= */

/* ===================== STATE & STORAGE ===================== */
const DOC_PREFIX = {
  'Quotation':'QUO',
  'Proforma Invoice':'PFI',
  'VAT Invoice':'VAT',
  'Purchase Order':'PO',
  'Delivery Note':'DN',
  'Deed of Sale':'DOS',
  'Agreement':'AGR'
};
const DOC_TYPES = Object.keys(DOC_PREFIX);

const VEHICLE_DOC_FLOW = ['Quotation','Proforma Invoice','VAT Invoice','Delivery Note','Deed of Sale','Agreement'];
const PARTS_DOC_FLOW = ['Quotation','VAT Invoice'];

const BRAND_CATEGORIES = {
  'Force': ['Spare Parts','Vans'],
  'Mahindra': ['Spare Parts','Tractors','Implements']
};

const DEFAULT_STATE = {
  role: 'Administrator',
  userName: '',
  cargo: [],
  inventory: [],
  customers: [],
  documents: [],
  counters: { 'Quotation':0,'Proforma Invoice':0,'VAT Invoice':0,'Purchase Order':0,'Delivery Note':0,'Deed of Sale':0,'Agreement':0 },
  settings: {
    company: { name:'', address:'', phone:'', email:'', vatNo:'' },
    vatRate: 15,
    lowStockThreshold: 5
  }
};

let state = JSON.parse(JSON.stringify(DEFAULT_STATE));
let storageReady = false;

function deepMerge(base, incoming){
  if(!incoming || typeof incoming !== 'object') return base;
  const out = Array.isArray(base) ? incoming : {...base};
  if(!Array.isArray(base) && typeof base === 'object'){
    for(const k in base){
      if(incoming[k] === undefined){ out[k] = base[k]; }
      else if(typeof base[k] === 'object' && base[k] !== null && !Array.isArray(base[k])){
        out[k] = deepMerge(base[k], incoming[k]);
      } else {
        out[k] = incoming[k];
      }
    }
  }
  return out;
}

async function loadData(){
  try{
    const res = await window.storage.get('dealership-data', true);
    if(res && res.value){
      const parsed = JSON.parse(res.value);
      state = deepMerge(DEFAULT_STATE, parsed);
    }
  }catch(e){
    // no existing record yet — start fresh
    console.log('No existing DealerDesk data found, starting fresh.');
  }
  storageReady = true;
}

let saveTimer = null;
async function saveData(){
  setSaveIndicator('saving');
  try{
    await window.storage.set('dealership-data', JSON.stringify(state), true);
    setSaveIndicator('saved');
  }catch(e){
    console.error('Save failed', e);
    setSaveIndicator('error');
    showToast('Could not save changes. Check your connection and try again.', 'error');
  }
}

function setSaveIndicator(status){
  const dot = document.getElementById('save-dot');
  const txt = document.getElementById('save-text');
  if(!dot || !txt) return;
  if(status === 'saving'){ dot.className = 'save-dot saving'; txt.textContent = 'Saving…'; }
  else if(status === 'saved'){ dot.className = 'save-dot'; txt.textContent = 'All changes saved'; }
  else { dot.className = 'save-dot'; dot.style.background = 'var(--danger)'; txt.textContent = 'Save failed'; }
}

/* ===================== UTILITIES ===================== */
function uid(){ return 'id_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2,8); }

function escapeHtml(str){
  if(str === null || str === undefined) return '';
  return String(str)
    .replaceAll('&','&amp;')
    .replaceAll('<','&lt;')
    .replaceAll('>','&gt;')
    .replaceAll('"','&quot;')
    .replaceAll("'",'&#39;');
}

function todayStr(){
  return new Date().toISOString().slice(0,10);
}

function formatDate(d){
  if(!d) return '—';
  const dt = new Date(d + (d.length<=10?'T00:00:00':''));
  if(isNaN(dt)) return d;
  return dt.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
}

function formatMoney(n){
  n = Number(n) || 0;
  return 'Rs ' + n.toLocaleString('en-MU', { minimumFractionDigits:2, maximumFractionDigits:2 });
}

function byId(id){ return document.getElementById(id); }

function qs(sel, root){ return (root||document).querySelector(sel); }
function qsa(sel, root){ return Array.from((root||document).querySelectorAll(sel)); }

function isAdmin(){ return state.role === 'Administrator'; }

function requireAdmin(actionLabel){
  if(!isAdmin()){
    showToast('Switch to Administrator role to ' + actionLabel + '.', 'error');
    return false;
  }
  return true;
}

