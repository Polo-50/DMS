function toggleQuickAddCustomer(){
  builderState.quickAdd = !builderState.quickAdd;
  refreshBuilder();
}

function switchBuilderType(t){
  builderState.type = t;
  builderState.notes = DEFAULT_TERMS[t];
  builderState.pricesIncludeVat = (t === 'VAT Invoice' || t === 'Proforma Invoice');
  refreshBuilder();
}

function refreshBuilder(){
  byId('modal-container').querySelector('.modal-body').innerHTML = builderBodyHtml();
}

function inventoryOptionsHtml(selectedId){
  let html = '';
  Object.keys(BRAND_CATEGORIES).forEach(brand=>{
    BRAND_CATEGORIES[brand].forEach(cat=>{
      const items = state.inventory.filter(i=>i.brand===brand && i.category===cat);
      if(items.length===0) return;
      html += '<optgroup label="'+brand+' — '+cat+'">';
      items.forEach(i=>{
        html += '<option value="'+i.id+'"'+(selectedId===i.id?' selected':'')+'>'+escapeHtml(i.name)+(i.code?' ('+escapeHtml(i.code)+')':'')+' — '+formatMoney(i.sellingPrice)+'</option>';
      });
      html += '</optgroup>';
    });
  });
  return html;
