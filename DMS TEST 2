async function saveInventoryForm(id){
  const name = byId('if-name').value.trim();
  if(!name){ showToast('Name is required.', 'error'); return; }
  const sellingPrice = parseFloat(byId('if-sell').value) || 0;
  let vatInclusive = parseFloat(byId('if-vatsell').value);
  if(!vatInclusive){ vatInclusive = +(sellingPrice * (1 + state.settings.vatRate/100)).toFixed(2); }

  const data = {
    brand: byId('if-brand').value,
    category: byId('if-category').value,
    code: byId('if-code').value.trim(),
    name,
    stock: parseFloat(byId('if-stock').value) || 0,
    costPrice: parseFloat(byId('if-cost').value) || 0,
    sellingPrice,
    vatInclusivePrice: vatInclusive,
  };
  if(id){
    const rec = state.inventory.find(i=>i.id===id);
    Object.assign(rec, data);
  } else {
    data.id = uid();
    data.createdAt = new Date().toISOString();
    state.inventory.push(data);
    invBrand = data.brand; invCategory = data.category;
  }
  await saveData();
  closeModal();
  showToast(id ? 'Item updated.' : 'Item added to inventory.', 'success');
  renderMain();
}

async function deleteInventory(id){
  if(!requireAdmin('delete inventory items')) return;
  if(!confirm('Delete this inventory item? This cannot be undone.')) return;
  state.inventory = state.inventory.filter(i=>i.id!==id);
  await saveData();
  showToast('Item removed from inventory.');
  renderMain();
}
